parameters:
    level: max
    phpVersion: 80400
    paths:
        - src
        - tests
        - bootstrap
    # The whole zdebug FFI blast radius is confined to OpArrayGate, which reads two
    # raw engine struct fields (op_array->filename / ->function_name) off the shaped
    # pointer z-engine returns. That shape alias is internal to z-engine and resolves
    # to an unknown class here, and the field values are mixed CData - unavoidable and
    # audited, so the FFI-shaped errors are ignored for this one file only.
    ignoreErrors:
        -
            identifier: class.notFound
            path: src/Instrumentation/OpArrayGate.php
        -
            identifier: argument.type
            path: src/Instrumentation/OpArrayGate.php
    reportUnmatchedIgnoredErrors: false

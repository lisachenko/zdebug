{
    "name": "lisachenko/zdebug",
    "description": "Step-debug PHP with PHP: an Xdebug-compatible (DBGp) debugger with no C extension, built on z-engine FFI",
    "type": "library",
    "keywords": ["debugger", "dbgp", "xdebug", "ffi", "zend", "engine", "step-debug"],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "require": {
        "php": "~8.4.0",
        "ext-ffi": "*",
        "lisachenko/z-engine": "8.4.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "suggest": {
        "ext-pcntl": "Signal-triggered async break (pause) support on the CLI SAPI"
    },
    "autoload": {
        "psr-4": {
            "ZDebug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZDebug\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-8.4-dev": "8.4.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --group integration --fail-on-skipped",
        "phpstan": "phpstan analyse",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the unit + integration test suite",
        "test:integration": "Run only the end-to-end DBGp integration tests and FAIL if they self-skip",
        "phpstan": "Run static analysis at the maximum level",
        "cs:check": "Check coding standards without fixing",
        "cs:fix": "Fix coding standards"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
